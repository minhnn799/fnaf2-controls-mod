<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>winmm</AssemblyName>
    <RootNamespace>Fnaf2Mod</RootNamespace>

    <!-- The game is 32-bit, so the proxy DLL must be x86 native code. -->
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <SelfContained>true</SelfContained>

    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>

  <!-- Native bootstrap and ABI-preserving WinMM forwarding stubs. -->
  <ItemGroup>
    <NativeLibrary Include="$(MSBuildProjectDirectory)\native\bootstrap.obj" />
    <LinkerArg Include="/ENTRY:ModDllEntry" />
    <LinkerArg Include="/DEF:&quot;$(MSBuildProjectDirectory)\winmm.def&quot;" />
  </ItemGroup>

<ItemGroup><EmbeddedResource Include="resources/night.patch" LogicalName="night.patch" /></ItemGroup>
</Project>
